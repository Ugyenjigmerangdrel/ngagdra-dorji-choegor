# ---------------------------------------------------------------------------
# Public (inlined into the browser bundle — never put secrets here)
# ---------------------------------------------------------------------------
# Canonical origin of this website, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.ngagdra.org
# The Supabase project shared with the committee studio. With these two unset the site
# still builds and runs: studio content is simply absent and the forms say they are unavailable.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). The legacy anon JWT also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server only
# ---------------------------------------------------------------------------
# Shared with the studio (same value on both sides). Lets the studio ask this site to refresh
# a page right after publishing: POST /api/revalidate with "Authorization: Bearer <secret>".
# Unset: the endpoint answers 503 and pages refresh on their own within a minute.
REVALIDATE_SECRET=

# Online payment through WONS Merchant (https://merchant.wons.bt/docs/api).
# "Pay online" appears on /donate only when WONS_API_KEY and WONS_SERVER_TOKEN are both set.
# API key from merchant.wons.bt → Settings → API, with scopes checkout.write and checkout.read.
# Keys beginning wtest_ are test keys and cannot move money.
WONS_API_KEY=
# Optional; defaults to https://merchant.wons.bt/api/v1
WONS_API_BASE=
# Signing secret of the webhook endpoint registered at merchant.wons.bt → Settings → Webhooks
# (URL: <site>/api/wons/webhook, event: checkout.completed).
WONS_WEBHOOK_SECRET=
# A long random string (24+ characters) this server shows the database when it confirms a paid
# donation. Its SHA-256 hash must be stored in private.integration_secrets under 'wons_server'
# (see the studio README, "Online payments").
WONS_SERVER_TOKEN=
